# ===== 智能分诊系统配置模板 =====
# 用法：复制本文件为 .env，填入真实值。
# .env 已被 .gitignore 排除（含敏感 key，切勿提交）。
# 字段名与 utils/config.py 的 Settings 类一一对应（大小写不敏感）。
# 未在 .env 中出现的字段使用 config.py 里的默认值。

# ---- 大模型（当前：deepseek 对话 + 通义 text-embedding-v1 向量）----
LLM_TYPE=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=你的DeepSeek_API_Key
DEEPSEEK_MODEL=deepseek-chat
DASHSCOPE_API_KEY=你的DashScope_API_Key
HITL_ENABLED=true
# ---- 其他模型（用到再填）----
# OPENAI_BASE_URL=
# OPENAI_API_KEY=

# ---- PostgreSQL（与 docker-compose.yml 对应）----
DB_URI=postgresql://postgres:postgres@localhost:5432/postgres?sslmode=disable

# ---- 混合检索重排（可选，默认值已可用）----
# RERANKER_MODEL_PATH=D:/ai/xtuner-env/大模型微调项目实战/demo_14/embedding_model/models/BAAI--bge-reranker-large/snapshots/master
# TRIAGE_RETRIEVAL_MODE=vector
